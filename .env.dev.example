# Скопируй в .env и заполни.
ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://tramplin:tramplin@localhost:5432/tramplin
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://tramplin:tramplin@localhost:5672/
FRONTEND_BASE_URL=http://localhost:5173

# On-premise Piston доступен только API/worker.
PISTON_URL=http://localhost:2000

# openssl rand -hex 32
JWT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Второй способ входа. Без client_id провайдер просто не появляется в интерфейсе.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/api/v1/auth/yandex/callback

# Третий способ входа. Без client_id провайдер просто не появляется в интерфейсе.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:8000/api/v1/auth/gitlab/callback

S3_BUCKET=tramplin
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Только для S3-совместимых провайдеров; для AWS не задавать.
# S3_ENDPOINT_URL=https://storage.example.com
# Публичный URL бакета, если endpoint внутри Docker недоступен браузеру.
# S3_PUBLIC_URL=https://cdn.example.com/tramplin
# ASSET_MAX_BYTES=10485760

# Ассистент урока. Протокол — OpenAI-совместимый /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Запасные модели через запятую: при ошибке до первого токена запрос уходит на следующую.
# LLM_FALLBACK_MODELS=minimax/minimax-m3:free
# SOCKS5/HTTP-прокси, если провайдер режет запросы из региона.
# LLM_PROXY_URL=socks5://user:pass@host:1080

# Эмбеддинги для рекомендаций — тот же LLM_API_KEY/LLM_BASE_URL, но своя
# модель: не факт, что у провайдера вообще есть text-embedding-3-small.
EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=512
# EMBEDDING_QUEUE_NAME=embedding-jobs

# Вход/привязка по email — код уходит в очередь, шлёт независимый email-service.
# EMAIL_TRANSACTIONAL_QUEUE_NAME=email-transactional
# EMAIL_BULK_QUEUE_NAME=email-bulk
# EMAIL_FROM_ADDRESS=noreply@tramplin.example
# EMAIL_CODE_TTL=PT10M
# EMAIL_CODE_COOLDOWN=PT60S
# EMAIL_CODE_MAX_ATTEMPTS=5

# Ниже — значения по умолчанию, задавать не обязательно.
# Длительности принимают секунды (900) или ISO 8601 (PT15M).
# ACCESS_TOKEN_TTL=PT15M
# REFRESH_TOKEN_TTL=P30D
# OAUTH_STATE_TTL=PT10M
# HTTP_TIMEOUT=PT10S
# REFRESH_TOKEN_BYTES=48
# OAUTH_STATE_BYTES=32
# JWT_ALGORITHM=HS256
# JWT_ISSUER=tramplin
# LLM_MAX_TOKENS=900
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=PT90S
# LLM_RETRIES=1
# LLM_HISTORY_LIMIT=10
# LLM_QUESTION_MAX_CHARS=2000
# LLM_DAILY_QUOTA=50
# LLM_GUEST_QUOTA=3
# LLM_GUEST_IP_QUOTA=60
# LLM_GUEST_DAILY_TOTAL=300
# GUEST_COOKIE_TTL=P30D
# ALGORITHM_SOURCE_MAX_BYTES=102400
# ALGORITHM_OUTPUT_MAX_BYTES=65536
# ALGORITHM_RUNS_PER_HOUR=60
# ALGORITHM_RUNS_PER_SESSION_PROBLEM=30
# ALGORITHM_JOB_TIMEOUT=PT30S
# ALGORITHM_QUEUE_NAME=algorithm-jobs
