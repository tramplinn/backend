<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ project_title }}</title>
    <style>
      body {
        margin: 0;
        background: #f4f5f7;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
      }
      .wrap { max-width: 480px; margin: 0 auto; padding: 40px 16px; }
      .brand-wrap { padding-bottom: 24px; text-align: center; }
      .brand-logo { display: block; }
      .brand-word {
        padding-left: 8px;
        font-size: 20px;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #2b7fff;
      }
      .card {
        background: #ffffff;
        border: 1px solid #e6e8ec;
        border-radius: 16px;
        padding: 40px 32px;
        text-align: center;
      }
      .eyebrow {
        margin: 0 0 20px;
        font-size: 13px;
        font-weight: 500;
        color: #8a8f98;
      }
      .title {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #0f0f11;
      }
      .lead {
        margin: 12px 0 24px;
        font-size: 15px;
        line-height: 1.6;
        color: #3a3d44;
      }
      .button {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 10px;
        background: #2b7fff;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
      }
      .note {
        margin: 24px 0 0;
        font-size: 13px;
        line-height: 1.6;
        color: #8a8f98;
      }
      .footer {
        margin: 24px 0 0;
        text-align: center;
        font-size: 12px;
        color: #8a8f98;
      }
    </style>
  </head>
  <body>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td>
          <div class="wrap">
            <div class="brand-wrap">
              <table role="presentation" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto">
                <tr>
                  <td valign="middle">
                    <img
                      class="brand-logo"
                      src="{{ logo_url }}"
                      width="37"
                      height="20"
                      alt="Tramplin"
                    />
                  </td>
                  <td valign="middle" class="brand-word">трамплин</td>
                </tr>
              </table>
            </div>
            <div class="card">
              <p class="eyebrow">Приглашение в проект</p>
              <p class="title">{{ project_title }}</p>
              <p class="lead">
                {{ inviter_name }} приглашает вас присоединиться в роли «{{ role_label }}».
              </p>
              <a class="button" href="{{ invites_url }}">Открыть приглашение</a>
              <p class="note">
                Приглашение действует 14 дней. Если вы не ждали его — просто
                проигнорируйте это письмо.
              </p>
            </div>
            <p class="footer">трамплин · автоматическое письмо, отвечать не нужно</p>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
