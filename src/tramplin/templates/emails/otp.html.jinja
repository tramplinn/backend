<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <style>
      body { margin: 0; background: #f4f5f7; font-family: Arial, Helvetica, sans-serif; }
      .wrap { max-width: 480px; margin: 0 auto; padding: 32px 16px; }
      .card { background: #ffffff; border-radius: 8px; padding: 32px; text-align: center; }
      .code {
        font-size: 32px;
        font-weight: bold;
        letter-spacing: 8px;
        color: #111827;
        margin: 24px 0;
      }
      .muted { color: #6b7280; font-size: 13px; line-height: 1.5; }
    </style>
  </head>
  <body>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td>
          <div class="wrap">
            <div class="card">
              <p>Код для входа в Tramplin:</p>
              <div class="code">{{ code }}</div>
              <p class="muted">
                Код действует {{ ttl_minutes }} минут. Если вы не запрашивали вход —
                просто проигнорируйте это письмо.
              </p>
            </div>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
