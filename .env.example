# Скопируй в .env и заполни.
ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://tramplin:tramplin@localhost:5432/tramplin
REDIS_URL=redis://localhost:6379/0
FRONTEND_BASE_URL=http://localhost:5173

# openssl rand -hex 32
JWT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

S3_BUCKET=tramplin
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Только для S3-совместимых провайдеров; для AWS не задавать.
# S3_ENDPOINT_URL=https://storage.example.com
# Публичный URL бакета, если endpoint внутри Docker недоступен браузеру.
# S3_PUBLIC_URL=https://cdn.example.com/tramplin
# ASSET_MAX_BYTES=10485760

# Ассистент урока. Протокол — OpenAI-совместимый /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Ниже — значения по умолчанию, задавать не обязательно.
# Длительности принимают секунды (900) или ISO 8601 (PT15M).
# ACCESS_TOKEN_TTL=PT15M
# REFRESH_TOKEN_TTL=P30D
# OAUTH_STATE_TTL=PT10M
# HTTP_TIMEOUT=PT10S
# REFRESH_TOKEN_BYTES=48
# OAUTH_STATE_BYTES=32
# JWT_ALGORITHM=HS256
# JWT_ISSUER=tramplin
# LLM_MAX_TOKENS=900
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=PT90S
# LLM_RETRIES=1
# LLM_HISTORY_LIMIT=10
# LLM_QUESTION_MAX_CHARS=2000
# LLM_DAILY_QUOTA=50
# LLM_GUEST_QUOTA=3
# LLM_GUEST_IP_QUOTA=60
# LLM_GUEST_DAILY_TOTAL=300
# GUEST_COOKIE_TTL=P30D
