# Скопируйте в .env.runtime. Файл с реальными секретами не коммитится.
ENVIRONMENT=production

# Сгенерируйте разные URL-safe пароли: openssl rand -hex 32
POSTGRES_USER=tramplin
POSTGRES_PASSWORD=replace-with-postgres-hex-secret
POSTGRES_DB=tramplin
REDIS_PASSWORD=replace-with-redis-hex-secret

# Общие сервисы из infra compose (сеть tramplin-edge).
RABBITMQ_USER=tramplin
RABBITMQ_PASSWORD=replace-with-rabbitmq-secret
JUDGE0_URL=http://tramplin-judge0:2358
JUDGE0_AUTH_TOKEN=replace-with-judge0-auth-token

# DATABASE_URL и REDIS_URL compose собирает сам через внутренние postgres/redis hosts.
FRONTEND_BASE_URL=https://staging.tramplin.example

# openssl rand -hex 32
JWT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.staging.tramplin.example/api/v1/auth/github/callback

# Второй способ входа. Без client_id провайдер просто не появляется в интерфейсе.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://api.staging.tramplin.example/api/v1/auth/yandex/callback

# Третий способ входа. Без client_id провайдер просто не появляется в интерфейсе.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=https://api.staging.tramplin.example/api/v1/auth/gitlab/callback

# OAuth-клиент FastMCP. Secret общий только для authorization server и MCP proxy.
MCP_OAUTH_CLIENT_ID=tramplin-fastmcp
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_REDIRECT_URI=https://mcp.staging.tramplin.example/auth/callback

# Cloud S3. Бакет создаётся инфраструктурой заранее, не приложением.
S3_BUCKET=tramplin-staging
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Для S3-compatible cloud раскомментируйте API endpoint; для AWS не задавайте.
# S3_ENDPOINT_URL=https://storage.example.com
# Публичный URL бакета или CDN без завершающего слеша.
# Текущая реализация assets ожидает, что объекты доступны на чтение по этому URL.
# S3_PUBLIC_URL=https://cdn.example.com/tramplin-staging
# ASSET_MAX_BYTES=10485760

# Ассистент необязателен: пустая модель или ключ отключают endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Максимальный размер ответа и передаваемого черновика помощника преподавателя.
# LLM_AUTHORING_MAX_TOKENS=4000
# LLM_AUTHORING_INPUT_MAX_CHARS=50000

# Эмбеддинги для рекомендаций используют тот же LLM_API_KEY/LLM_BASE_URL.
# Модель зависит от провайдера — пустая модель или ключ отключают расчёт
# эмбеддингов, рекомендации считаются только по overlap тем и новизне.
EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=512
# EMBEDDING_QUEUE_NAME=embedding-jobs

# ALGORITHM_SOURCE_MAX_BYTES=102400
# ALGORITHM_OUTPUT_MAX_BYTES=65536
# ALGORITHM_RUNS_PER_HOUR=60
# ALGORITHM_RUNS_PER_SESSION_PROBLEM=30
# ALGORITHM_JOB_TIMEOUT=PT30S
